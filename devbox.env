# Mode: "golden" applies the configuration once while building an image (devbox build) and
# `devbox up` clones it. "ephemeral" recreates the VM from TART_IMAGE and provisions it on every
# `devbox up`.
DEVBOX_MODE="golden"

# Golden mode: the image the golden image is built from, and the name of the golden image.
# A guest cannot be newer than the host.
DEVBOX_GOLDEN_IMAGE="ghcr.io/cirruslabs/macos-tahoe-vanilla:latest"
DEVBOX_GOLDEN_NAME="devbox-golden"

# Ephemeral mode: base Tart image to pull on every fresh start.
TART_IMAGE="ghcr.io/cirruslabs/macos-tahoe-base:latest"

# Local VM name (the VM you work in). In golden mode it is cloned from the golden image.
TART_VM_NAME="devbox"

# VM sizing. Memory is in megabytes. A disk size above 50 GB is applied by removing the macOS recovery
# partition and letting the guest grow its system container at boot (it can only be increased).
TART_CPU="6"
TART_MEMORY_MB="12288"
TART_DISPLAY="1728x1117pt"
TART_DISK_GB="60"
DEVBOX_INHERIT_HOST_DISPLAY="1"
# Golden mode: resize the guest display together with the window.
DEVBOX_DISPLAY_REFIT="1"

# Host directory mounted into the guest at /Volumes/My Shared Files/<name>.
# Relative paths are resolved from the repo root. Defaults to the repo root.
DEVBOX_SHARE_NAME="workspace"
DEVBOX_SHARE_PATH="."

# Optional extra mounts into /Volumes/My Shared Files/<name>.
DEVBOX_MOUNT_HOME="0"
DEVBOX_HOME_MOUNT_NAME="home"
DEVBOX_HOME_MOUNT_PATH="~"
DEVBOX_HOME_MOUNT_READ_ONLY="1"

DEVBOX_MOUNT_SSH="0"
DEVBOX_SSH_MOUNT_NAME="ssh"
DEVBOX_SSH_MOUNT_PATH="~/.ssh"
DEVBOX_SSH_MOUNT_READ_ONLY="1"

# Remote staging directory used during provisioning (ephemeral mode).
DEVBOX_STAGE_DIR="/Users/admin/.devbox"

# Guest defaults.
DEVBOX_TIMEZONE="Europe/Zurich"
DEVBOX_INHERIT_HOST_TIMEZONE="1"
DEVBOX_KEYBOARD_LAYOUT_NAME="Swiss German"
DEVBOX_KEYBOARD_LAYOUT_ID="19"
DEVBOX_KEYBOARD_LAYOUT_SOURCE_ID="com.apple.keylayout.SwissGerman"
DEVBOX_INHERIT_HOST_KEYBOARD="1"
DEVBOX_INHERIT_HOST_DOCK="1"
DEVBOX_INHERIT_HOST_APPEARANCE="1"
DEVBOX_INHERIT_HOST_SCROLL_DIRECTION="1"
DEVBOX_INHERIT_HOST_KEY_REPEAT="1"
DEVBOX_INHERIT_HOST_TRACKPAD="1"
DEVBOX_INHERIT_HOST_GITCONFIG="1"
# Golden mode only: language and region (formats, units), Finder, menu bar clock, screenshots.
DEVBOX_INHERIT_HOST_REGION="1"
DEVBOX_INHERIT_HOST_UI="1"

# Golden mode: provisioning of the image.
DEVBOX_INSTALL_ROSETTA="1"
# The vanilla image ships with Gatekeeper off; switch it on again.
DEVBOX_ENABLE_GATEKEEPER="1"
# No first-launch "downloaded from the Internet" dialog for the apps installed from the Brewfile.
DEVBOX_TRUST_BREWFILE_APPS="1"
# Dock items, separated by | (apps that are not installed are skipped).
DEVBOX_DOCK_APPS="/Applications/Microsoft Edge.app|/Applications/Visual Studio Code.app|/System/Applications/Utilities/Terminal.app|/System/Applications/System Settings.app"

# Provisioning behavior.
DEVBOX_BREWFILE="guest/Brewfile"
DEVBOX_WAIT_TIMEOUT="600"
DEVBOX_POLL_INTERVAL="5"

# Extra flags passed verbatim to `tart run` (space-separated).
TART_RUN_EXTRA_ARGS=""
