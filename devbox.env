# Base Tart image to pull on every fresh start.
TART_IMAGE="ghcr.io/cirruslabs/macos-tahoe-base:latest"

# Local VM name created from the upstream image.
TART_VM_NAME="devbox"

# VM sizing. Memory is in megabytes.
TART_CPU="6"
TART_MEMORY_MB="12288"
TART_DISPLAY="1728x1117pt"
TART_DISK_GB="60"
DEVBOX_INHERIT_HOST_DISPLAY="1"

# Host directory mounted into the guest at /Volumes/My Shared Files/<name>.
# Relative paths are resolved from the repo root. Defaults to the repo root.
DEVBOX_SHARE_NAME="workspace"
DEVBOX_SHARE_PATH="."

# Optional extra mounts into /Volumes/My Shared Files/<name>.
DEVBOX_MOUNT_HOME="0"
DEVBOX_HOME_MOUNT_NAME="home"
DEVBOX_HOME_MOUNT_PATH="~"
DEVBOX_HOME_MOUNT_READ_ONLY="1"

DEVBOX_MOUNT_SSH="0"
DEVBOX_SSH_MOUNT_NAME="ssh"
DEVBOX_SSH_MOUNT_PATH="~/.ssh"
DEVBOX_SSH_MOUNT_READ_ONLY="1"

# Remote staging directory used during provisioning.
DEVBOX_STAGE_DIR="/Users/admin/.devbox"

# Guest defaults.
DEVBOX_TIMEZONE="Europe/Zurich"
DEVBOX_INHERIT_HOST_TIMEZONE="1"
DEVBOX_KEYBOARD_LAYOUT_NAME="Swiss German"
DEVBOX_KEYBOARD_LAYOUT_ID="19"
DEVBOX_KEYBOARD_LAYOUT_SOURCE_ID="com.apple.keylayout.SwissGerman"
DEVBOX_INHERIT_HOST_KEYBOARD="1"
DEVBOX_INHERIT_HOST_DOCK="1"
DEVBOX_INHERIT_HOST_APPEARANCE="1"
DEVBOX_INHERIT_HOST_SCROLL_DIRECTION="1"
DEVBOX_INHERIT_HOST_KEY_REPEAT="1"
DEVBOX_INHERIT_HOST_TRACKPAD="1"
DEVBOX_INHERIT_HOST_GITCONFIG="1"

# Provisioning behavior.
DEVBOX_BREWFILE="guest/Brewfile"
DEVBOX_WAIT_TIMEOUT="600"
DEVBOX_POLL_INTERVAL="5"

# Extra flags passed verbatim to `tart run` (space-separated).
TART_RUN_EXTRA_ARGS=""